NODE_ENV='development'
PORT=3000

WINSTON_LOG_LEVEL='info'
WINSTON_LOG_PATH=logs

API_BASE_URL=http://localhost:3000
API_VERSION='v1'

SAIA_API_KEY=your-3dlook-api-key

SUPABASE_URL=your-supabase-url
SUPABASE_PUBLISHABLE_KEY=your-supabase-key

# Sandbox: https://api.sandbox.airwallex.com
# Production: https://api.airwallex.com
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=your-airwallex-client-id
AIRWALLEX_API_KEY=your-airwallex-api-key
AIRWALLEX_WEBHOOK_SECRET=your-airwallex-webhook-secret

# Applied server-side when creating a PaymentIntent (0.08 = 8%)
TAX_RATE=0.08

DATABASE_HOST=your-db-host
DATABASE_PORT=5432
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password
DATABASE_NAME=your-db-name

MOCK_3DLOOK=true

APP_TOKEN=frontend-token

TEMPLATE_FILE='order.xlsx'

#STORAGE_PROVIDER=local
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=orders
LOCAL_UPLOAD_DIR=uploads
